# اسم النموذج اللغوي المحلي في Ollama (لازم يكون متسحّب مسبقًا: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# مسار مجلد الـ Vector Store المُصدَّر من النوتبوك
VECTOR_STORE_PATH=./data/vector_store
COLLECTION_NAME=ml_notes

# اسم نموذج الـ Embeddings (لازم يطابق اللي استخدمته في النوتبوك بالظبط)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# عدد القطع (chunks) اللي يتم استرجاعها لكل سؤال
TOP_K=4

# أصل الفرونت إند المسموح له بالوصول (CORS)
FRONTEND_ORIGIN=http://localhost:8501

# اتركها False عند التشغيل الفعلي — True فقط للاختبار بدون إنترنت
OFFLINE_DEMO_EMBEDDINGS=False
